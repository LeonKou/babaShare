# babaShare配置示例；程序只读取项目根.env中的BABA_SHARE_*配置，进程环境优先。
# 监听接口；默认监听所有IPv4网卡，可显式设127.0.0.1限制为本机。
# 0.0.0.0不是浏览器访问地址；不会自动放行防火墙。
BABA_SHARE_HOST=0.0.0.0
BABA_SHARE_PORT=8080

# 数据根目录；相对路径始终相对项目根目录，不受启动工作目录影响。
# 数据库位于数据根下data/baba-share.sqlite3，上传文件位于filedb/。
# 首次初始化直接创建完整当前模型；启动校验现有结构，不执行补列、表重建或字段转换。
# 只使用固定数据库文件，不搜索、迁移、合并或删除其他名称的数据库。
# 结构校验失败应核对数据根与数据库，不自动清库或换用空目录。
BABA_SHARE_DATA_DIR=.

# 只启动一个HTTP服务，主站/API/MCP/沙箱预览均使用同一端口。
# PUBLIC_ORIGIN仅构造外部分享/预览URL，不是Host/Origin准入白名单。
# 填写浏览器实际访问的HTTP(S)来源，不含路径，不能填写0.0.0.0。
# 通配监听且未配置时回退到http://127.0.0.1:端口；局域网/公网应配置真实IP或域名。
# 配错影响生成链接，不阻断正常代理登录/退出。
# 网关负责域名准入、TLS和限流；Nginx终止HTTPS后可向本服务转发HTTP，无需后端TLS。
# BABA_SHARE_PUBLIC_ORIGIN=https://share.example.com
# 外部HTTPS时仍设为1；只是浏览器Cookie的Secure属性，不要求上游HTTPS。
# BABA_SHARE_SECURE_COOKIE=1

# .env仅从项目根目录读取，进程环境优先；不是shell脚本，不做变量展开。
# Windows服务脚本默认使用ProgramData私有数据根，并以服务环境覆盖DATA_DIR/HOST/PORT等。
# Compose宿主端口与默认公开来源联动；非本机访问应显式配置PUBLIC_ORIGIN以生成可访问链接。
# 宿主默认发布到所有IPv4网卡；可显式设127.0.0.1仅供本机反向代理访问。
# BABA_SHARE_PUBLISH_IP=0.0.0.0
# BABA_SHARE_PUBLISH_PORT=8080
# BABA_SHARE_VOLUME_NAME=baba-share-data

BABA_SHARE_SESSION_HOURS=24
BABA_SHARE_TICKET_SECONDS=900
BABA_SHARE_MAX_BODY_BYTES=67108864

# SMTP服务器、TLS方式与发件人在管理员「设置/注册设置」的邮件配置中填写并提交。
# 保存邮件配置时自动记录当前浏览器Origin，无需手填站点来源；应通过用户实际可访问地址配置。
# 注册、找回密码与邮箱绑定/换绑邮件优先使用当前请求Origin；缺失时回退已保存的站点来源。
# 邮件来源独立于PUBLIC_ORIGIN；公网使用HTTPS，网关须校验公开Origin并禁止绕过网关直连后端。
# 可选认证密码优先于data/smtp-password，不要在示例、源码、镜像或日志填写真实密码。
# 未注入时，页面密码保存到数据根下独立明文秘密文件；POSIX 0600，Windows依赖私有ACL。
# 环境密码不能通过页面覆盖/清除；留空保留文件，显式清除需管理员确认。
# BABA_SHARE_SMTP_PASSWORD=
